# =============================================================================
# 抵达 Reach —— 环境变量样例
# =============================================================================
# 用法：复制为 .env 后按需修改。所有项都有内置默认值，最小可用配置是「全部留空」。
# 启动时后端会打印一份「配置提醒」，并可通过 GET /health 查看当前生效配置
# （密钥自动脱敏）。生产部署前请通读「安全」与「推送」两节。
# =============================================================================


# -----------------------------------------------------------------------------
# 基础
# -----------------------------------------------------------------------------
# 运行环境：dev | prod。设为 prod 时，配置风险会以 error 级别打进日志。
APP_ENV=dev
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 业务时区（IANA 名称）。**决定任务到期提醒的触发时刻**：任务的
# "9月1日 09:00" 会按此时区解释后转 UTC 比较。容器时区通常是 UTC，
# 若此项与用户实际所在时区不一致，提醒会整体偏移。
APP_TIMEZONE=Asia/Shanghai


# -----------------------------------------------------------------------------
# 数据库
# -----------------------------------------------------------------------------
# 留空默认使用 SQLite（server/goalflow.db）。
# PostgreSQL 示例：postgresql+asyncpg://user:pass@db:5432/goalflow
DATABASE_URL=sqlite+aiosqlite:///./goalflow.db
# 是否打印所有 SQL（排查问题用，生产务必关闭——会打出参数值）
DB_ECHO=0
# 连接池（仅对 PostgreSQL 等网络数据库生效，SQLite 忽略）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# -----------------------------------------------------------------------------
# 安全 / 鉴权
# -----------------------------------------------------------------------------
# JWT 签名密钥。留空时后端会自动生成随机密钥并持久化到 server/.jwt_secret。
# 生产环境请显式注入：openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
# 令牌有效期（分钟）。1440 = 1 天；移动端体验优先可设 43200（30 天）。
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 注册与改密时的最短密码长度
PASSWORD_MIN_LENGTH=6
# 允许的前端源，逗号分隔。**不要写 `*`**：与携带凭证的请求组合非法且危险。
# 同源部署（Docker 单镜像）时本项可留默认值不用管。
CORS_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# 限流（防登录爆破）
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=1
# 窗口内允许的最大请求数
RATE_LIMIT_MAX=10
# 窗口长度（秒）
RATE_LIMIT_WINDOW=60
# 受保护路径，逗号分隔。留空使用内置默认：
#   /api/auth/login,/api/auth/register,/api/auth/me/password
RATE_LIMIT_PATHS=
# 多实例部署时填 Redis 地址改用共享计数器；留空则用进程内内存计数
# （单实例足够，多实例下每个进程各算一份，等效阈值会被放大）。
# 示例：redis://redis:6379/0
RATE_LIMIT_REDIS_URL=


# -----------------------------------------------------------------------------
# 分页
# -----------------------------------------------------------------------------
# 列表接口 limit 的默认值与硬上限
PAGE_SIZE_DEFAULT=100
PAGE_SIZE_MAX=500


# -----------------------------------------------------------------------------
# 演示数据
# -----------------------------------------------------------------------------
# 是否自动创建演示账号 demo/reach2024（SQLite 发布版默认开；PostgreSQL 需显式置 1）
SEED_DEMO_ACCOUNT=1
# 是否播种演示业务数据：留空=不播种；1=库为空时播种；force=每次启动重建
SEED_DEMO_DATA=


# -----------------------------------------------------------------------------
# 提醒调度
# -----------------------------------------------------------------------------
# 总开关。关闭后后端不再扫描到期任务（移动端的本机本地提醒仍然工作）。
REMINDER_ENABLED=1
# 全局默认提前量（分钟），0 = 到期时刻。
# 单个任务可用 remind_before_minutes 字段覆盖本值。
REMINDER_LEAD_MINUTES=10
# 扫描周期（秒）。太小会空转，太大会导致提醒不准。
REMINDER_INTERVAL_SECONDS=60
# 只扫描到期日落在 now ± 该小时数内的任务，避免每周期全表扫。
# 若你有「提前 7 天提醒」的任务，请把它调到 168 以上。
REMINDER_SCAN_WINDOW_HOURS=48
# 兼容旧变量名（若已设置新名则以新名为准）
# FCM_REMINDER_ENABLED=1
# FCM_REMINDER_LEAD_MINUTES=10


# -----------------------------------------------------------------------------
# 推送通道 A：FCM（Android with GMS / Web）
# -----------------------------------------------------------------------------
# 凭证二选一：
#   方式 A：直接给 Firebase Admin SDK 服务账号 JSON 文件路径
FCM_SERVICE_ACCOUNT_JSON=
#   方式 B：拆分的三要素（私钥里的换行用 \n 转义成字面两字符）
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# 推送通道 B：华为 Push Kit（HarmonyOS 客户端 / 无 GMS 设备）
# -----------------------------------------------------------------------------
# 来自 AppGallery Connect → 项目设置 → 常规信息。
# **鸿蒙端云推送必须配它**：HarmonyOS NEXT 上不存在 Google 服务，FCM 永远送不达。
# 未配置时鸿蒙端会退化为「本机本地提醒」（离线可用，但应用被彻底清理后可能失效）。
HMS_CLIENT_ID=
HMS_CLIENT_SECRET=
# 通常不需要改
HMS_OAUTH_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HMS_PUSH_URL=https://push-api.cloud.huawei.com/v3/{app_id}/messages:send
# 点击通知拉起的 Ability 名
HMS_TARGET_ABILITY=EntryAbility


# -----------------------------------------------------------------------------
# 第三方数据源（农历 / 节假日）
# -----------------------------------------------------------------------------
# 万年历接口账号。默认 88888888 是公共测试账号，量大会被限频，
# 建议到 https://www.apihz.cn 申请自有账号。
APIHZ_ID=88888888
APIHZ_KEY=88888888
# 农历结果缓存时长（小时）；0 = 不缓存
LUNAR_CACHE_TTL_HOURS=24
# 法定节假日数据源
HOLIDAY_API_BASE=https://api.jiejiariapi.com/v1/holidays
# 调用上游的超时（秒）
UPSTREAM_TIMEOUT_SECONDS=10


# -----------------------------------------------------------------------------
# 功能开关
# -----------------------------------------------------------------------------
# 回收站（软删除）。关闭后删除即物理删除，不可恢复。
FEATURE_TRASH=1
# 回收站保留天数，超期由后台调度器自动物理清除
TRASH_RETENTION_DAYS=30
# ICS 日历订阅（GET /api/calendar.ics?token=...）。
# 该接口用独立的 feed_token 免登录访问，可在客户端设置页重置。
FEATURE_ICS_FEED=1
# 数据导入 / 备份恢复（POST /api/import）
FEATURE_IMPORT=1


# -----------------------------------------------------------------------------
# Docker Compose 专用（PostgreSQL 容器凭证）
# -----------------------------------------------------------------------------
# POSTGRES_DB=goalflow
# POSTGRES_USER=goalflow
# POSTGRES_PASSWORD=请改成强密码
