# 依赖
node_modules/
.pnp/
.pnp.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 本地数据库（运行时生成）
*.db

# 用户上传的图片（运行时生成，含隐私数据）
server/uploads/
*.sqlite3

# 密钥 / 环境变量
.env
.env.local
.jwt_secret

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# 内部 / 代理
.codebuddy/

# 日志
*.log

# 编辑器 / 环境配置
.cloudstudio

# Vite 构建临时缓存（build 时生成的 vite.config 时间戳副本）
web/vite.config.*.timestamp-*.mjs

# 前端构建产物：vite 输出到 web/dist，由根 Dockerfile 拷入 server/public，
# 在容器内生成，不属于源码，不应提交（避免哈希化资源产生大量 diff）。
web/dist/

# 临时提交信息文件（git commit -F 用，勿纳入版本库）
.git-commit-msg.txt
